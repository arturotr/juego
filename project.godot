[physics]

3d/physics_engine="Jolt Physics"

[popochiu]

pixel/pixel_art_textures=true
aseprite_import/import_animation_by_default=false
aseprite_import/new_props_visible_by_default=false
aseprite_import/new_props_clickable_by_default=false
aseprite_import/only_visible_layers=false
aseprite_import/wipe_old_animations=false

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
