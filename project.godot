[display]

window/size/viewport_width=320
window/size/viewport_height=200
window/size/window_width_override=320
window/size/window_height_override=200
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/popochiu/editor/gizmos/plugin.cfg", "res://addons/popochiu/editor/importers/plugin.cfg", "res://addons/popochiu/plugin.cfg")

[input]

